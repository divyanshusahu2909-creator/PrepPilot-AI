# Copy this file to .env and fill in your values.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL Database
DB_NAME=preppilot_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306

# Gemini AI — get a free key at https://aistudio.google.com/apikey
# Leave EMPTY to run in clearly-labeled demo mode (heuristic feedback, no real AI).
# When a key is set, all AI features use real Gemini responses.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_DEMO_MODE=True

# JWT
JWT_ACCESS_TOKEN_LIFETIME_HOURS=1
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Email (for password reset). In DEBUG, links print to the console instead.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Google OAuth (optional) — Web client ID from Google Cloud Console
GOOGLE_CLIENT_ID=

# Frontend URL (for password reset emails)
FRONTEND_URL=http://localhost:5173

# File upload max size in MB
MAX_UPLOAD_SIZE_MB=5